<?php
$connected = $block->connected();
$installation = $block->installation();
$channels = $block->channels();
$assigned = $block->assigned();
$agents = $block->agents();
$wizard = $block->wizard();
$step = $block->step();
$view = $block->view();
$connect = $block->getRequest()->getParam('connect');
$failed = $block->agentsFailed();
$inactive = $block->inactive();
$badge = static function (array $setting) use ($escaper): void {
    $code = (string) ($setting['status'] ?? 'idle'); ?>
    <span class="agent001-badge"
          data-role="sync-status"
          data-status="<?= $escaper->escapeHtmlAttr($code) ?>"><?= $escaper->escapeHtml(__($code)) ?></span>
<?php };
$meta = static function (array $setting) use ($escaper, $block): void {
    $date = $block->syncDate(date: (string) ($setting['last_sync_at'] ?? '')); ?>
    <span class="agent001-meta">
        <?= $escaper->escapeHtml(__('Products')) ?>:
        <span data-role="sync-count"><?= (int) ($setting['count'] ?? 0) ?></span>
        <span data-role="sync-date" <?= empty($date) ? 'hidden' : '' ?>><?= $escaper->escapeHtml($date) ?></span>
        <span data-role="skipped-row" <?= empty($setting['skipped']) ? 'hidden' : '' ?>>
            <?= $escaper->escapeHtml(__('Skipped')) ?>:
            <span data-role="sync-skipped"><?= (int) ($setting['skipped'] ?? 0) ?></span>
        </span>
    </span>
<?php };
$status = static function (int $storeId, array $channel) use ($escaper, $badge, $meta): void {
    $setting = $channel['setting'];
    $message = (string) __($setting['message'] ?? '');
    $running = in_array(needle: $setting['status'] ?? '', haystack: ['queued', 'reading', 'indexing'], strict: true); ?>
    <div class="agent001-status" data-store="<?= (int) $storeId ?>" role="status" aria-live="polite">
        <?php $badge($setting); ?>
        <?php $meta($setting); ?>
        <progress data-role="sync-progress"
                  aria-label="<?= $escaper->escapeHtmlAttr(__('Synchronization progress')) ?>"
                  <?= $running ? '' : 'hidden' ?>></progress>
        <p data-role="sync-message" <?= empty($message) ? 'hidden' : '' ?>>
            <?= $escaper->escapeHtml($message) ?>
        </p>
        <p class="message message-error" data-role="failed-row" <?= $channel['failures'] ? '' : 'hidden' ?>>
            <?= $escaper->escapeHtml(__('Failed background jobs:')) ?>
            <span data-role="failed-jobs"><?= (int) $channel['failures'] ?></span>
            <button class="action-tertiary agent001-small"
                    form="agent001-retry-<?= (int) $storeId ?>"
                    name="operation"
                    value="retry">
                <?= $escaper->escapeHtml(__('Retry')) ?>
            </button>
        </p>
        <div class="message message-warning" data-role="worker-warning" <?= $channel['stalled'] ? '' : 'hidden' ?>>
            <?= $escaper->escapeHtml(__('The worker is not running. Start it on the server:')) ?>
            <code>php bin/magento agent001:work</code>
        </div>
    </div>
<?php };
$catalog = static function (int $storeId, array $channel) use ($escaper, $block, $status): void {
    $selected = $channel['setting']['categories'] ?? [];
    $all = empty($selected); ?>
    <fieldset class="agent001-catalog" data-role="category-group">
        <legend><?= $escaper->escapeHtml($block->storeLabel(storeId: $storeId)) ?></legend>
        <input type="hidden" name="catalog[]" value="<?= (int) $storeId ?>">
        <div class="agent001-chips"
             data-role="category-summary"
             data-all="<?= $escaper->escapeHtmlAttr(__('All categories (entire catalog)')) ?>"
             data-empty="<?= $escaper->escapeHtmlAttr(__('No category selected')) ?>"
             data-remove="<?= $escaper->escapeHtmlAttr(__('Remove')) ?>"
             aria-live="polite"></div>
        <div class="agent001-picker">
            <input type="search"
                   data-role="category-search"
                   placeholder="<?= $escaper->escapeHtmlAttr(__('Search categories')) ?>"
                   aria-label="<?= $escaper->escapeHtmlAttr(__('Search categories')) ?>">
            <button type="button" class="action-tertiary" data-role="select-all">
                <?= $escaper->escapeHtml(__('Select all')) ?>
            </button>
            <button type="button" class="action-tertiary" data-role="clear-all">
                <?= $escaper->escapeHtml(__('Clear')) ?>
            </button>
            <select id="agent001-categories-<?= (int) $storeId ?>"
                    class="admin__control-multiselect"
                    name="categories[<?= (int) $storeId ?>][]"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Categories')) ?>"
                    multiple
                    size="10"
                    data-role="category-select">
                <?php foreach ($block->categories(storeId: $storeId) as $category): ?>
                    <?php
                    $chosen = $all || in_array(needle: $category['id'], haystack: $selected, strict: true);
                    $indent = str_repeat(string: "\u{2003}", times: max(0, count(value: $category['path']) - 3));
                    ?>
                    <option value="<?= (int) $category['id'] ?>"
                            data-path="<?= $escaper->escapeHtmlAttr(implode('/', $category['path'])) ?>"
                            data-label="<?= $escaper->escapeHtmlAttr($category['name']) ?>"
                            <?= $chosen ? 'selected' : '' ?>>
                        <?= $escaper->escapeHtml($indent . $category['name']) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
        <?php $status($storeId, $channel); ?>
    </fieldset>
<?php };
?>
